{
  "info": {
    "_postman_id": "d9f5aa73-1c91-4db1-9327-dfd7dbd5b4a0",
    "name": "Crystalloids Posts API",
    "description": "Cloud Run and local requests for the Posts API. Set the environment token from `gcloud auth print-identity-token` before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Serverless-Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Post created', () => pm.response.to.have.status(201));",
                  "pm.environment.set('post_id', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "X-Serverless-Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Postman post\",\n  \"body\": \"Created from Postman.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/posts"
          }
        },
        {
          "name": "List Posts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "X-Serverless-Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": "{{base_url}}/posts?limit=20"
          }
        },
        {
          "name": "Get Post",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "X-Serverless-Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": "{{base_url}}/posts/{{post_id}}"
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "X-Serverless-Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Updated from Postman.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/posts/{{post_id}}"
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "X-Serverless-Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": "{{base_url}}/posts/{{post_id}}"
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Create Comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Comment created', () => pm.response.to.have.status(201));",
                  "pm.environment.set('comment_id', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "X-Serverless-Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Comment created from Postman.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/posts/{{post_id}}/comments"
          }
        },
        {
          "name": "List Comments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "X-Serverless-Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": "{{base_url}}/posts/{{post_id}}/comments?limit=20"
          }
        },
        {
          "name": "Update Comment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "X-Serverless-Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Updated comment from Postman.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/posts/{{post_id}}/comments/{{comment_id}}"
          }
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "X-Serverless-Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": "{{base_url}}/posts/{{post_id}}/comments/{{comment_id}}"
          }
        }
      ]
    }
  ]
}
