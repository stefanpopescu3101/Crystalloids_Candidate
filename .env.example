GOOGLE_CLOUD_PROJECT=crystalloids-candidates
# Explicit development/demo mode for gcloud auth print-identity-token.
# Verifies Google signatures, expiry and issuer, but not an app-specific audience.
ALLOW_GCLOUD_DEV_TOKENS=true
# For production app sign-in: disable the flag and set the expected OAuth client ID.
# GOOGLE_OAUTH_CLIENT_ID=your-client.apps.googleusercontent.com
FIRESTORE_DATABASE=stefan-database
POSTS_COLLECTION=posts
COMMENT_EVENTS_TOPIC=stefan-comments-topic
# For an emulator, export FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 in your shell.
# Google's SDK does not read this file directly. Never set it on Cloud Run.
